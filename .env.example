# 复制为 .env 后填写。不要把正式 licence 提交进 Git。
APP_SECRET=change-this-local-secret
APP_HOST=127.0.0.1
APP_PORT=8765

# 管理员（首次启动自动建号）
BOOTSTRAP_USER=hanish
BOOTSTRAP_PASSWORD=change-me

# 麦蕊证书：主证书 + 备用（逗号分隔）。某张当日 429 后自动换下一张，次日重置。
# 也可只填 MAIRUI_LICENCE 单张。
MAIRUI_LICENCE=2FE37018-1B80-4185-91C5-05D4799A4572
MAIRUI_LICENCES=0911733C-31DD-454C-ADCA-5CC002806939

# 1 = 工作台展示内置样例（fixtures.py 保留不删）。0 = 只用麦蕊现网。
MAIRUI_OFFLINE=0

# DeepSeek（OpenAI 兼容 Chat Completions + Tool Calling）。留空则走确定性编排。
# 默认 deepseek-flash（较便宜）；thinking 在代码里关掉以省 token，并兼容现有 Tool 循环。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=45

# 可选。盯盘命中后 POST JSON；留空则只写本机 alerts 与 data/alerts.log
ALERT_WEBHOOK=

# 超过该只数的查询/导出改为后台任务（job_id 轮询）
QUERY_SYNC_LIMIT=40

# 本机 data/ 占用：缓存上限、每人最多留几份 Excel、日线最多几根、alerts.log 超过多少 MB 裁切
CACHE_MAX_MB=300
ARTIFACT_KEEP=20
BARS_MAX=500
ALERTS_LOG_MAX_MB=2

# 墙钟账本目录（网盘共享文件夹）。也可在工作台「本机数据」里填写。不要填整个 data/。
# 若该目录本身已是带 remote 的独立 git 仓库，写档后会自动 commit quotes/ 与 universe/ 并 push（不会写入本软件仓库）。
# CLOCK_DIR=
# CLOCK_INTERVAL_SEC=300
