# 复制为 .env 后填写。不要把正式 licence 提交进 Git。
APP_SECRET=change-this-local-secret
APP_HOST=127.0.0.1
APP_PORT=8765

# 管理员（首次启动自动建号）
BOOTSTRAP_USER=hanish
BOOTSTRAP_PASSWORD=change-me

# 正式 licence。演示 licence 会被门禁拒绝写入缓存。
MAIRUI_LICENCE=

# 1 = 不访问外网，使用内置样例数据，便于无 licence 时跑通 S1/S2
MAIRUI_OFFLINE=1

# DeepSeek（OpenAI 兼容 Chat Completions + Tool Calling）。留空则走确定性编排。
# 不要用 deepseek-reasoner 做 Tool 选择；问答编排默认 deepseek-chat。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=45

# 可选。盯盘命中后 POST JSON；留空则只写本机 alerts 与 data/alerts.log
ALERT_WEBHOOK=

# 超过该只数的查询/导出改为后台任务（job_id 轮询）
QUERY_SYNC_LIMIT=40
